[Unit]
Description=Amazon SP-API OAuth Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amazon-oauth
Group=amazon-oauth
WorkingDirectory=/opt/amazon-oauth-service
EnvironmentFile=/etc/amazon-oauth-service.env
EnvironmentFile=-/etc/amazon-sp-api-storage.env
ExecStart=/usr/bin/node /opt/amazon-oauth-service/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/amazon-oauth-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
